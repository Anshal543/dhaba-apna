# Copy to .env (cp .env.example .env). .env is git-ignored.
# Local development values only. Real passwords never go in Git.
#
# One file for the whole repo. Docker Compose reads POSTGRES_*.
# menu-api reads POSTGRES_* and REDIS_* from this file directly.
# orders-api, kitchen-worker, and stats-api read DB_* / REDIS_* from the
# process environment:  set -a && source .env && set +a

# --- Postgres (docker compose + menu-api) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dhaba
POSTGRES_PASSWORD=dhaba_local_dev
POSTGRES_DB=dhaba

# --- Same database, names from docs/CONTRACT.md (orders-api, kitchen-worker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dhaba
DB_USER=dhaba
DB_PASSWORD=dhaba_local_dev
DB_SSLMODE=disable

# --- Redis (every service) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLIENT=predis

# --- orders-api ---
PORT=8080
APP_VERSION=dev
CORS_ORIGIN=*

# --- kitchen-worker ---
COOKING_SECONDS=8

# --- menu-api ---
MENU_CACHE_TTL_SECONDS=60

# --- stats-api (Laravel). Loaded from this file, not a second .env. ---
APP_NAME=stats-api
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:ejUr45vHlS4AqL7cKa9hwBcoewFikFw0eZKyBQDVaAY=
APP_URL=http://localhost:8001
LOG_CHANNEL=stderr

# --- local ports (no two services share a port) ---
MENU_API_PORT=8000
ORDERS_API_PORT=8080
STATS_API_PORT=8001
WEB_PORT=5173

# --- web dev proxy / Nginx upstreams ---
MENU_API_URL=http://localhost:8000
ORDERS_API_URL=http://localhost:8080
STATS_API_URL=http://localhost:8001
