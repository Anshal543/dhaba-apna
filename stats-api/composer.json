{
    "name": "dhaba/stats-api",
    "type": "project",
    "description": "Live numbers from Redis: orders per minute and top dishes",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "predis/predis": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
